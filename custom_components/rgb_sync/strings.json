{
  "title": "RGB Sync",
  "config": {
    "step": {
      "user": {
        "title": "Whole-house RGB",
        "description": "One hub keeps every RGB controller in your home in sync. Add the first light on the next screen.",
        "data": {
          "name": "Hub name"
        }
      },
      "add_menu": {
        "title": "Add a light",
        "description": "Pick the protocol used by this light, or finish the setup.",
        "menu_options": {
          "wled": "WLED (WiFi)",
          "network": "Network controller (HTTP / TCP / UDP)",
          "ble": "Bluetooth LE controller",
          "matter": "Matter light (existing entity)",
          "mqtt": "MQTT topic",
          "finish": "Finish setup"
        }
      },
      "wled": {
        "title": "Add a WLED controller",
        "description": "Enter the LAN address of the WLED instance. The pixel count is read automatically.",
        "data": {
          "name": "Name",
          "host": "Host / IP address",
          "port": "HTTP port",
          "pixels": "Pixel count (fallback)",
          "enabled": "Include in whole-house sync"
        }
      },
      "network": {
        "title": "Add a network controller",
        "description": "Send state to any LAN device with a configurable HTTP, TCP or UDP endpoint. Templates support {on}, {brightness}, {brightness_pct}, {r}, {g}, {b}, {hex}, {effect} and {speed}.",
        "data": {
          "name": "Name",
          "net_protocol": "Protocol",
          "host": "Host / IP address",
          "port": "Port",
          "path": "Path (HTTP only)",
          "method": "HTTP method",
          "body": "Payload template",
          "pixels": "Pixel count",
          "enabled": "Include in whole-house sync"
        }
      },
      "ble": {
        "title": "Add a Bluetooth LE controller",
        "description": "The address looks like AA:BB:CC:DD:EE:FF. The Triones profile covers most generic BLE RGB controllers; use the generic profile for a custom command set.",
        "data": {
          "name": "Name",
          "address": "Bluetooth address",
          "ble_profile": "Command profile",
          "service_uuid": "Service UUID",
          "char_uuid": "Characteristic UUID",
          "color_template": "Colour command template (hex)",
          "power_on_hex": "Power-on command (hex)",
          "power_off_hex": "Power-off command (hex)",
          "enabled": "Include in whole-house sync"
        }
      },
      "matter": {
        "title": "Add a Matter light",
        "description": "Pick a light entity that belongs to a Matter bulb. Colour and brightness changes are forwarded to that entity.",
        "data": {
          "name": "Name",
          "entity_id": "Light entity",
          "enabled": "Include in whole-house sync"
        }
      },
      "mqtt": {
        "title": "Add an MQTT light",
        "description": "Publish state to an MQTT topic. Templates support {state}, {on}, {brightness}, {brightness_pct}, {r}, {g}, {b}, {hex}, {effect} and {speed}.",
        "data": {
          "name": "Name",
          "topic": "Topic",
          "qos": "QoS",
          "retain": "Retain message",
          "body": "Payload template",
          "enabled": "Include in whole-house sync"
        }
      },
      "discovered": {
        "title": "Device discovered",
        "description": "RGB Sync found {name} ({protocol}) on your network. Add it to the whole-house hub?"
      }
    },
    "error": {
      "cannot_connect": "The device did not answer. Check the address and that local control is enabled.",
      "invalid_device": "The device definition is incomplete.",
      "unknown": "Unexpected error."
    },
